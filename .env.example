# Limited Recovery Basket AI - decision service configuration (example, NO secrets).
# Copy to a protected location (NOT the repo). The Windows installer writes service.env for you.

# Shared HMAC secret: path to a file readable only by the service user (>= 32 chars).
# On the MT5 host the same file is <Common>\Files\LRB\hmac_secret.txt (read by LRB_AIBridge).
LRB_HMAC_SECRET_FILE=C:\Users\<trading-user>\AppData\Roaming\MetaQuotes\Terminal\Common\Files\LRB\hmac_secret.txt
# LRB_HMAC_SECRET=          # alternative to the file; avoid on shared hosts
LRB_KEY_ID=ea1

# Network: plain HTTP is only accepted on loopback. Non-loopback binds require TLS.
LRB_BIND_HOST=127.0.0.1
LRB_PORT=8787
# LRB_TLS_CERT=/etc/lrb/tls/cert.pem
# LRB_TLS_KEY=/etc/lrb/tls/key.pem

LRB_DB_PATH=C:\LRB\data\lrb_service.db
LRB_ALLOWED_SYMBOLS=EURUSD
LRB_DECISION_TTL_SEC=60
LRB_MAX_SKEW_SEC=30
LRB_MAX_DATA_AGE_SEC=1200
LRB_RETENTION_DAYS=30
LRB_LOG_LEVEL=INFO

# Optional: a LogisticModel JSON produced by `lrb-backtest train` - only after walk-forward
# validation on REAL broker ticks. Without it the service uses the deterministic rules-v1 filter.
# LRB_MODEL_PATH=C:\LRB\data\entry_model.json

# Optional: required for the dashboard when it is not accessed from loopback (e.g. via an SSH tunnel).
# LRB_DASHBOARD_TOKEN=

# Never put broker logins/passwords here: the service does not need them and never trades.
